
<%- include('../partials/header', { pageTitle: pageTitle }) %>

<div class="card" style="margin-top: 1.5rem;">
 <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
    <h2>Master Data Produk</h2>
    <a href="/produk/tambah" class="btn btn--primary" style="padding: 0.5rem 1rem; text-decoration: none;
background: #0284c7; color: white; border-radius: 4px;">+ Tambah Produk Baru</a>
</div>

<table border="1" cellpadding="8" cellspacing="0" style="width: 100%; border-collapse: collapse; text-align:
left;">
    <thead style="background: #f8fafc;">
     <tr>
        <th>ID</th>
        <th>Nama Produk</th>
        <th>Kategori</th>
        <th>Harga</th>
        <th>Stok</th>
        <th>Aksi</th>
    </tr>
 </thead>
 <tbody>
    <% if (produkList.length === 0) { %>
     <tr><td colspan="6" style="text-align: center;">Belum ada data produk di basis data.</td></tr>
  <% } else { %>
    <% produkList.forEach(item => { %>
     <tr>
        <td><%= item.id %></td>
        <td><%= item.nama_produk %></td>
        <td><%= item.kategori %></td>
        <td>Rp <%= item.harga.toLocaleString('id-ID') %></td>
        <td><%= item.stok %></td>
        <td>
        <a href="/produk/edit/<%= item.id %>" style="color: #0284c7; margin-right: 0.5rem;">Edit</a>
        <form action="/produk/hapus/<%= item.id %>" method="POST" style="display: inline;" 
onsubmit="return confirm('Yakin ingin menghapus produk ini?');">
        <button type="submit" style="color: #ef4444; background: none; border: none; cursor: pointer;
text-decoration: underline;">Hapus</button>
        </form>
       </td>
      </tr>
    <% }) %>
    <% } %>
  </tbody>
 </table> 
</div>

<%- include('../partials/footer') %>